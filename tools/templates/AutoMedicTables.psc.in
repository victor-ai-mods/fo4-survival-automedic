Scriptname AutoMedicTables extends Quest

; =====================================================================
;  ЭТОТ ФАЙЛ СОБИРАЕТСЯ АВТОМАТИЧЕСКИ — правки руками будут потеряны.
;    логика  -> tools/templates/AutoMedicTables.psc.in
;    данные  -> data/consumables.json  (шаг 1 плана)
;    сборка  -> python tools/gen_psc.py
; %%STAMP%%
; =====================================================================
;
; Зачем это нужно. В Fallout 4 у Papyrus НЕТ интроспекции ALCH: `Potion`
; наследует только `Form`, перечислить эффекты предмета в рантайме нельзя
; (§3 плана). Поэтому числа считаются офлайн парсером esm и приезжают сюда
; константами.
;
; Почему таблица разбита на чанки. Массив Papyrus создаётся не длиннее 128
; элементов, а предметов больше трёхсот — отсюда `ItemChunk()` и арифметика
; `index / CHUNK_SIZE`.
;
; Почему формы DLC резолвятся в рантайме, а не лежат в esp. `FormList` с
; предметом из DLC потребовал бы этот DLC в мастерах плагина. Вместо этого
; таблица хранит пару «локальный FormID + имя файла», а `BuildTables()`
; прогоняет их через `Game.GetFormFromFile()`: файла нет — форма молча
; пропускается, и мастер по-прежнему нужен ровно один (§8.1).

; Пустой в esp, наполняется на BuildTables().
FormList Property AM_AllConsumables Auto Const Mandatory
; Списки по нужде (2026-09-22), тоже пустые в esp: какие предметы годятся под
; ОЗ, радиацию, голод, жажду, болезни, зависимости, конечности. Авторежим
; одним GetItemCount(список) видит, что появилось средство от незакрытой нужды.
FormList Property AM_ListHP Auto Const Mandatory
FormList Property AM_ListRads Auto Const Mandatory
FormList Property AM_ListHunger Auto Const Mandatory
FormList Property AM_ListThirst Auto Const Mandatory
FormList Property AM_ListDisease Auto Const Mandatory
FormList Property AM_ListAddiction Auto Const Mandatory
FormList Property AM_ListLimbs Auto Const Mandatory

; --- роли эффектов ---------------------------------------------------
%%ROLES%%

; --- биты поля Flags -------------------------------------------------
%%FLAGS%%

; --- размеры таблиц --------------------------------------------------
%%SIZES%%

Struct ItemData
    ; Item == None — предмет из не установленного DLC, использовать нельзя.
    Form Item
    Int LocalId
    ; Индекс в PluginFiles().
    Int PluginId
    Float HealHP
    ; ПРОЦЕНТ от максимума ОЗ, а не доля: у стимпака здесь 30.0 = 30 %.
    ; Масштабируется перком Medic в рантайме (M7).
    Float HealPctOfMax
    ; 0 = мгновенно. Растяжение лечения в Survival (M6) в esm не записано —
    ; остаток лечения берётся из GetActiveEffects, а не считается отсюда.
    Float HealSeconds
    Float RadsAdd
    Float RadsRemove
    Float ApRestore
    Float AddictionChance
    Int DiseaseRiskPct
    Int Flags
    ; Эффект, который усиливают перк Medic и бобблхед «Медицина» (M7): его
    ; магнитуда и длительность в esm. Medic прибавляет к магнитуде, поэтому
    ; рантайм вычитает этот вклад из HealPctOfMax / RadsRemove и считает заново.
    ; 0 — у предмета такого эффекта нет.
    Float MedicHealMag
    Float MedicHealDur
    Float MedicRadMag
    Float MedicRadDur
    ; Полный FormID с индексом загрузки — считается в BuildTables(). По нему
    ; инвентарь (GetNthItemFormID) находит строку без Game.GetForm и HasForm:
    ; каждый такой вызов ждёт кадра (шаг 5, замер шага 3 — 76 мс на предмет).
    Int FullId
EndStruct

Struct PerkVariant
    Int ItemIndex
    Int Role
    ; Величина эффекта, когда перк есть: заменяет базовую, а не складывается с ней.
    Float Amount
    ; Локальные FormID перков в Fallout4.esm; условие — «любой из них». 0 = пусто.
    Int Perk1
    Int Perk2
    Int Perk3
EndStruct

Struct ChanceEffect
    Int ItemIndex
    Int Role
    Int ChancePct
    Float Amount
EndStruct

; Эффект, по которому считается недоставленное «в полёте» (§5): лечение,
; вывод и набор радиации, ОД. Снимок GetActiveEffects даёт MagicEffect, а
; роль эффекта рантайм узнать не может — она приезжает отсюда.
Struct EffectData
    MagicEffect Effect
    Int LocalId
    Int PluginId
    Int Role
EndStruct

; --- кеш, собранный BuildTables() (уезжает в сейв) --------------------
%%CACHE_VARS%%
EffectData[] AM_Effects
; Варианты по перкам из включённых слоёв исправлений (UFO4P): ванильные строки
; тех же предметов в AM_Perks* при сборке гасятся (ItemIndex = -1).
PerkVariant[] AM_PatchPerks
; Маска слоёв (бит на файл PatchFiles()), с которой таблица собрана: поставили
; или убрали патч — IsBuilt() скажет «пересобрать».
Int AM_BuiltPatches = -1

Int AM_Resolved = 0
Int AM_Skipped = 0
; Разрешились, но индекс загрузки файла не нашёлся: такие предметы инвентарь
; не увидит. Должно быть 0 — пишется в лог при сборке.
Int AM_NoFullId = 0
Int AM_BuiltVersion = 0

; =====================================================================
;  Сборка
; =====================================================================

Bool Function IsBuilt()
    Return AM_BuiltVersion == DATA_VERSION && AM_BuiltPatches == InstalledPatchMask()
EndFunction

; Слои исправлений, чьи файлы сейчас в порядке загрузки: бит i — PatchFiles()[i].
Int Function InstalledPatchMask()
    String[] names = PatchFiles()
    Int mask = 0
    Int bit = 1
    Int p = 0
    While p < names.Length
        If Game.IsPluginInstalled(names[p])
            mask += bit
        EndIf
        bit *= 2
        p += 1
    EndWhile
    Return mask
EndFunction

; Какие слои включены в текущую таблицу (для лога).
String Function ActivePatchNames()
    String[] names = PatchFiles()
    String out = ""
    Int bit = 1
    Int p = 0
    While p < names.Length
        If AM_BuiltPatches > 0 && (AM_BuiltPatches / bit) % 2 == 1
            If out != ""
                out += ", "
            EndIf
            out += names[p]
        EndIf
        bit *= 2
        p += 1
    EndWhile
    Return out
EndFunction

Int Function ResolvedCount()
    Return AM_Resolved
EndFunction

Int Function SkippedCount()
    Return AM_Skipped
EndFunction

Int Function NoFullIdCount()
    Return AM_NoFullId
EndFunction

; Разрешает формы и раскладывает таблицу по чанкам. Идемпотентна: повторный
; вызов без abForce ничего не делает, пока версия данных не изменилась.
Function BuildTables(Bool abForce = false)
    If IsBuilt() && !abForce
        Return
    EndIf

    AM_AllConsumables.Revert()
    AM_ListHP.Revert()
    AM_ListRads.Revert()
    AM_ListHunger.Revert()
    AM_ListThirst.Revert()
    AM_ListDisease.Revert()
    AM_ListAddiction.Revert()
    AM_ListLimbs.Revert()
    AM_Resolved = 0
    AM_Skipped = 0
    AM_NoFullId = 0

    ; Слои исправлений: строки, которыми включённый патч заменяет ванильные,
    ; и номера этих строк в таблице. Более поздний слой главнее.
    Int patchMask = InstalledPatchMask()
    ItemData[] patchRows = new ItemData[0]
    Int[] patchTargets = new Int[0]
    AM_PatchPerks = new PerkVariant[0]
    Int bit = 1
    Int p = 0
    While p < PATCH_COUNT
        If (patchMask / bit) % 2 == 1
            ItemData[] layerRows = RawPatchItems(p)
            Int[] layerTargets = RawPatchTargets(p)
            Int r = 0
            While r < layerRows.Length
                Int known = patchTargets.Find(layerTargets[r])
                If known >= 0
                    patchRows[known] = layerRows[r]
                Else
                    patchRows.Add(layerRows[r], 1)
                    patchTargets.Add(layerTargets[r], 1)
                EndIf
                r += 1
            EndWhile
            PerkVariant[] layerPerks = RawPatchPerks(p)
            r = 0
            While r < layerPerks.Length
                AM_PatchPerks.Add(layerPerks[r], 1)
                r += 1
            EndWhile
        EndIf
        bit *= 2
        p += 1
    EndWhile

    String[] files = PluginFiles()
    ; Индекс загрузки каждого файла; -1 — ещё не найден (или файла нет).
    Int[] loadIndex = new Int[files.Length]
    Int f = 0
    While f < files.Length
        loadIndex[f] = -1
        f += 1
    EndWhile
    Int chunk = 0
    While chunk < ITEM_CHUNKS
        ItemData[] rows = RawItems(chunk)
        Int t = 0
        While t < patchTargets.Length
            If patchTargets[t] / CHUNK_SIZE == chunk
                rows[patchTargets[t] % CHUNK_SIZE] = patchRows[t]
            EndIf
            t += 1
        EndWhile
        Int i = 0
        While i < rows.Length
            Form found = Game.GetFormFromFile(rows[i].LocalId, files[rows[i].PluginId])
            If found != None
                rows[i].Item = found
                Int pid = rows[i].PluginId
                If loadIndex[pid] < 0
                    loadIndex[pid] = FindLoadIndex(found, rows[i].LocalId)
                EndIf
                If loadIndex[pid] >= 0
                    rows[i].FullId = loadIndex[pid] * 16777216 + rows[i].LocalId
                Else
                    AM_NoFullId += 1
                EndIf
                AM_AllConsumables.AddForm(found)
                AddToNeedLists(found, rows[i])
                AM_Resolved += 1
            Else
                AM_Skipped += 1
            EndIf
            i += 1
        EndWhile
        SetItemChunk(chunk, rows)
        chunk += 1
    EndWhile

    ; Эффекты — один чанк: их меньше CHUNK_SIZE (генератор это проверяет).
    AM_Effects = RawEffects()
    Int e = 0
    While e < AM_Effects.Length
        AM_Effects[e].Effect = Game.GetFormFromFile(AM_Effects[e].LocalId,                                                     files[AM_Effects[e].PluginId]) as MagicEffect
        e += 1
    EndWhile

    ; Варианты по перкам у предметов, которые заменил слой, берутся из слоя
    ; (AM_PatchPerks), а ванильные гасятся.
    chunk = 0
    While chunk < PERK_CHUNKS
        PerkVariant[] perkRows = RawPerks(chunk)
        If patchTargets.Length > 0
            Int k = 0
            While k < perkRows.Length
                If patchTargets.Find(perkRows[k].ItemIndex) >= 0
                    perkRows[k].ItemIndex = -1
                EndIf
                k += 1
            EndWhile
        EndIf
        SetPerkChunk(chunk, perkRows)
        chunk += 1
    EndWhile

    chunk = 0
    While chunk < CHANCE_CHUNKS
        SetChanceChunk(chunk, RawChances(chunk))
        chunk += 1
    EndWhile

    AM_BuiltVersion = DATA_VERSION
    AM_BuiltPatches = patchMask
EndFunction

; Те же признаки, что UsesOf в AutoMedicQuestScript (без учёта перков и настроек).
; Чёрный список — мимо: мод его не тронет никогда, и прибавка такого предмета
; (служебные «Антибиотики» 249F2C из консоли) не должна будить проверку.
Function AddToNeedLists(Form akItem, ItemData akData)
    If HasFlag(akData.Flags, FLAG_BLACKLISTED)
        Return
    EndIf
    If akData.HealHP > 0.0 || akData.HealPctOfMax > 0.0
        AM_ListHP.AddForm(akItem)
    EndIf
    If akData.RadsRemove > 0.0
        AM_ListRads.AddForm(akItem)
    EndIf
    If HasFlag(akData.Flags, FLAG_SATES_HUNGER)
        AM_ListHunger.AddForm(akItem)
    EndIf
    If HasFlag(akData.Flags, FLAG_SATES_THIRST)
        AM_ListThirst.AddForm(akItem)
    EndIf
    If HasFlag(akData.Flags, FLAG_CURES_DISEASE)
        AM_ListDisease.AddForm(akItem)
    EndIf
    If HasFlag(akData.Flags, FLAG_CURES_ADDICTION)
        AM_ListAddiction.AddForm(akItem)
    EndIf
    If HasFlag(akData.Flags, FLAG_CAT_STIMPAK) && akData.HealPctOfMax > 0.0
        AM_ListLimbs.AddForm(akItem)
    EndIf
EndFunction

; Список под нужду по биту USE_* AutoMedicQuestScript (1 hp, 2 rads, 4 hunger,
; 8 thirst, 16 disease, 32 addiction, 128 limbs) или None.
FormList Function NeedList(Int aiUse)
    If aiUse == 1
        Return AM_ListHP
    ElseIf aiUse == 2
        Return AM_ListRads
    ElseIf aiUse == 4
        Return AM_ListHunger
    ElseIf aiUse == 8
        Return AM_ListThirst
    ElseIf aiUse == 16
        Return AM_ListDisease
    ElseIf aiUse == 32
        Return AM_ListAddiction
    ElseIf aiUse == 128
        Return AM_ListLimbs
    EndIf
    Return None
EndFunction

; Индекс загрузки файла, которому принадлежит akFound: перебор старшего
; байта, пока Game.GetForm(полный ID) не вернёт ту же форму. Узнать FormID
; формы напрямую нельзя — Form.GetFormID есть только в F4SE, а его исходников
; в сборке нет. Файлы таблицы — только .esm (Fallout4 и DLC), они грузятся
; первыми, так что это единицы вызовов на файл. -1 — не нашли.
Int Function FindLoadIndex(Form akFound, Int aiLocalId)
    Int idx = 0
    While idx < 254
        If Game.GetForm(idx * 16777216 + aiLocalId) == akFound
            Return idx
        EndIf
        idx += 1
    EndWhile
    Return -1
EndFunction

; =====================================================================
;  Предметы игрока (Data\SurvivalAutoMedic\items-user.json, 2026-09-30)
; =====================================================================
;
; Эффекты предмета из чужого мода Papyrus прочитать не может, поэтому числа
; (лечение, радиация, ОД) вписывает игрок, а всё, что видно по ключевым словам
; (категории, голод, жажда, риск болезни), считается здесь — по тем же правилам,
; что parse_consumables.py и gen_psc.item_flags() для ванили. Разбор файла — в
; AutoMedicQuestScript.LoadUserItems. Эти строки живут в отдельном чанке
; USER_CHUNK (индексы USER_CHUNK * CHUNK_SIZE + i) и ищутся ПЕРВЫМИ: так запись
; игрока может заменить числа и у предмета из таблицы (мод, меняющий ванильный
; предмет). Вариантов по перкам у них нет.

; Генератор проверяет, что основных чанков не больше трёх, так что 3 свободен.
Int Property USER_CHUNK = 3 AutoReadOnly Hidden
Int Property USER_MAX = 128 AutoReadOnly Hidden

ItemData[] AM_UserItems
Keyword[] AM_UserKw

%%USER_KEYWORDS%%

ItemData[] Function UserItems()
    If AM_UserItems == None
        AM_UserItems = new ItemData[0]
    EndIf
    Return AM_UserItems
EndFunction

; Новый набор предметов игрока. Прежние убираются из списков нужд, если их нет
; в основной таблице; новые туда добавляются.
Function SetUserItems(ItemData[] akRows)
    ItemData[] old = UserItems()
    Int i = 0
    While i < old.Length
        If old[i].Item != None && IndexOfTable(old[i].Item) < 0
            AM_AllConsumables.RemoveAddedForm(old[i].Item)
            AM_ListHP.RemoveAddedForm(old[i].Item)
            AM_ListRads.RemoveAddedForm(old[i].Item)
            AM_ListHunger.RemoveAddedForm(old[i].Item)
            AM_ListThirst.RemoveAddedForm(old[i].Item)
            AM_ListDisease.RemoveAddedForm(old[i].Item)
            AM_ListAddiction.RemoveAddedForm(old[i].Item)
            AM_ListLimbs.RemoveAddedForm(old[i].Item)
        EndIf
        i += 1
    EndWhile
    AM_UserItems = akRows
    i = 0
    While i < akRows.Length
        AM_AllConsumables.AddForm(akRows[i].Item)
        AddToNeedLists(akRows[i].Item, akRows[i])
        i += 1
    EndWhile
EndFunction

Bool Function HasUserKw(Form akItem, Int aiKw)
    Return AM_UserKw[aiKw] != None && akItem.HasKeyword(AM_UserKw[aiKw])
EndFunction

; Flags и DiseaseRiskPct строки игрока по ключевым словам её предмета.
; aiExtraFlags — то, что по ключевым словам не видно и игрок указал сам
; (лечит болезнь / зависимость, баф, аддиктивный); aiRisk >= 0 — его риск
; болезни вместо вычисленного.
Function FillFromKeywords(ItemData akRow, Int aiExtraFlags, Int aiRisk)
    If AM_UserKw == None
        Int[] ids = UserKeywordIds()
        AM_UserKw = new Keyword[ids.Length]
        Int k = 0
        While k < ids.Length
            AM_UserKw[k] = Game.GetFormFromFile(ids[k], "Fallout4.esm") as Keyword
            k += 1
        EndWhile
    EndIf
    Form f = akRow.Item
    Bool food = HasUserKw(f, KW_OBJECTTYPEFOOD)
    Bool drink = HasUserKw(f, KW_OBJECTTYPEDRINK)
    Bool water = HasUserKw(f, KW_OBJECTTYPEWATER)
    Bool chem = HasUserKw(f, KW_OBJECTTYPECHEM)
    Bool alcohol = HasUserKw(f, KW_OBJECTTYPEALCOHOL)
    Bool cola = HasUserKw(f, KW_OBJECTTYPENUKACOLA)
    Bool ignoreAsFood = HasUserKw(f, KW_HC_IGNOREASFOOD)
    Bool quench = HasUserKw(f, KW_HC_SUSTENANCETYPE_QUENCHESTHIRST)

    Int flags = aiExtraFlags
    If food || drink || water || alcohol || cola
        flags += FLAG_FOOD
    EndIf
    If food
        flags += FLAG_CAT_FOOD
    EndIf
    If drink
        flags += FLAG_CAT_DRINK
    EndIf
    If water
        flags += FLAG_CAT_WATER
    EndIf
    If chem
        flags += FLAG_CAT_CHEM
    EndIf
    If HasUserKw(f, KW_CA_OBJTYPE_CHEMBAD)
        flags += FLAG_CAT_CHEM_BAD
    EndIf
    If alcohol
        flags += FLAG_CAT_ALCOHOL
    EndIf
    If cola
        flags += FLAG_CAT_COLA
    EndIf
    If HasUserKw(f, KW_OBJECTTYPECAFFEINATED) || HasUserKw(f, KW_OBJECTTYPEEXTRACAFFEINATED)
        flags += FLAG_CAT_CAFFEINATED
    EndIf
    If HasUserKw(f, KW_OBJECTTYPESTIMPAK)
        flags += FLAG_CAT_STIMPAK
    EndIf
    If HasUserKw(f, KW_FRUITORVEGETABLE)
        flags += FLAG_CAT_FRUIT_VEG
    EndIf
    If HasUserKw(f, KW_OBJECTTYPESYRINGERAMMO)
        flags += FLAG_CAT_SYRINGER
    EndIf
    If quench
        flags += FLAG_QUENCHES_THIRST
    EndIf
    If HasUserKw(f, KW_HC_SUSTENANCETYPE_INCREASESHUNGER)
        flags += FLAG_INCREASES_HUNGER
    EndIf
    If HasUserKw(f, KW_HC_SUSTENANCETYPE_INCREASESTHIRST)
        flags += FLAG_INCREASES_THIRST
    EndIf
    If ignoreAsFood
        flags += FLAG_IGNORE_AS_FOOD
        If !chem
            flags += FLAG_WILD_PLANT
        EndIf
    EndIf
    If HasUserKw(f, KW_HC_CAUSESIMMUNODEFICIENCY)
        flags += FLAG_IMMUNO_DEF
    EndIf
    ; Голод и жажда — ровно правила ванильного HC_ManagerScript (см. gen_psc).
    If food && !ignoreAsFood && !HasUserKw(f, KW_HC_EFFECTTYPE_DISEASE) && \
            !HasUserKw(f, KW_HC_EFFECTTYPE_HUNGER) && !HasUserKw(f, KW_HC_EFFECTTYPE_SLEEP) && \
            !HasUserKw(f, KW_HC_EFFECTTYPE_THIRST) && !HasUserKw(f, KW_HC_EFFECTTYPE_ADRENALINE) && \
            !HasUserKw(f, KW_ADDICTIONKEYWORDJET)
        flags += FLAG_SATES_HUNGER
    EndIf
    If quench || HasUserKw(f, KW_ANIMFURNWATER)
        flags += FLAG_SATES_THIRST
    EndIf

    Int risk = aiRisk
    If risk < 0
        risk = 0
        If HasUserKw(f, KW_HC_DISEASERISK_FOODHIGH)
            risk = 12
        ElseIf HasUserKw(f, KW_HC_DISEASERISK_FOODSTANDARD) || HasUserKw(f, KW_HC_DISEASERISKCHEM)
            risk = 7
        ElseIf cola
            risk = 2
        ElseIf (food || drink || water || alcohol) && !ignoreAsFood
            risk = 1
        EndIf
    EndIf
    If risk >= 7
        flags += FLAG_IMMEDIATE_CHECK
    EndIf
    akRow.DiseaseRiskPct = risk
    akRow.Flags = flags
EndFunction

; Индекс только в основной таблице (без предметов игрока) или -1.
Int Function IndexOfTable(Form akItem)
    Int chunk = 0
    While chunk < ITEM_CHUNKS
        ItemData[] rows = ItemChunk(chunk)
        Int slot = rows.FindStruct("Item", akItem, 0)
        If slot >= 0
            Return chunk * CHUNK_SIZE + slot
        EndIf
        chunk += 1
    EndWhile
    Return -1
EndFunction

; =====================================================================
;  Доступ
; =====================================================================

; Данные предмета по индексу в таблице. Индекс вне диапазона даёт пустую
; структуру с Item == None — вызывающему достаточно проверить Item.
ItemData Function GetItemData(Int aIndex)
    Int userSlot = aIndex - USER_CHUNK * CHUNK_SIZE
    If userSlot >= 0 && userSlot < UserItems().Length
        Return AM_UserItems[userSlot]
    EndIf
    If aIndex < 0 || aIndex >= ITEM_COUNT
        ItemData empty = new ItemData
        Return empty
    EndIf
    ItemData[] rows = ItemChunk(aIndex / CHUNK_SIZE)
    Return rows[aIndex % CHUNK_SIZE]
EndFunction

; Индекс предмета в таблице или -1. Поиск идёт по кешу (FindStruct — нативный),
; а не по FormList: в списке лежат только разрешившиеся формы, и его индексы
; с индексами таблицы не совпадают.
Int Function IndexOf(Form akItem)
    If akItem == None
        Return -1
    EndIf
    Int user = UserItems().FindStruct("Item", akItem, 0)
    If user >= 0
        Return USER_CHUNK * CHUNK_SIZE + user
    EndIf
    Int chunk = 0
    While chunk < ITEM_CHUNKS
        ItemData[] rows = ItemChunk(chunk)
        Int slot = rows.FindStruct("Item", akItem, 0)
        If slot >= 0
            Return chunk * CHUNK_SIZE + slot
        EndIf
        chunk += 1
    EndWhile
    Return -1
EndFunction

; То же по полному FormID (из GardenOfEden.GetNthItemFormID). Только
; FindStruct — ни одного вызова, ждущего кадра.
Int Function IndexOfFullId(Int aiFormId)
    If aiFormId == 0
        Return -1
    EndIf
    Int user = UserItems().FindStruct("FullId", aiFormId, 0)
    If user >= 0
        Return USER_CHUNK * CHUNK_SIZE + user
    EndIf
    Int chunk = 0
    While chunk < ITEM_CHUNKS
        ItemData[] rows = ItemChunk(chunk)
        Int slot = rows.FindStruct("FullId", aiFormId, 0)
        If slot >= 0
            Return chunk * CHUNK_SIZE + slot
        EndIf
        chunk += 1
    EndWhile
    Return -1
EndFunction

; Роль активного эффекта (ROLE_*) или ROLE_NONE, если эффект нам не интересен.
Int Function EffectRole(MagicEffect akEffect)
    If akEffect == None || AM_Effects == None
        Return ROLE_NONE
    EndIf
    Int slot = AM_Effects.FindStruct("Effect", akEffect, 0)
    If slot < 0
        Return ROLE_NONE
    EndIf
    Return AM_Effects[slot].Role
EndFunction

Int Function EffectCount()
    If AM_Effects == None
        Return 0
    EndIf
    Return AM_Effects.Length
EndFunction

; Сам массив (по ссылке): AutoMedicQuestScript держит его у себя, чтобы
; не делать внешний вызов EffectRole на каждый активный эффект.
EffectData[] Function GetEffects()
    Return AM_Effects
EndFunction

; Быстрая проверка членства без вычисления индекса.
Bool Function IsKnown(Form akItem)
    Return AM_AllConsumables.HasForm(akItem)
EndFunction

; Только для однобитных масок. Битовых операций в ванильном Papyrus нет,
; а тянуть ради одной проверки F4SE-расширение Math не хочется.
Bool Function HasFlag(Int aFlags, Int aMask) global
    Return (aFlags / aMask) % 2 == 1
EndFunction

; Варианты эффекта, включающиеся перками (M7). Пусто для большинства предметов.
PerkVariant[] Function GetPerkVariants(Int aItemIndex)
    PerkVariant[] out = new PerkVariant[0]
    Int chunk = 0
    While chunk < PERK_CHUNKS
        PerkVariant[] rows = PerkChunk(chunk)
        Int i = rows.FindStruct("ItemIndex", aItemIndex, 0)
        While i >= 0
            out.Add(rows[i], 1)
            ; Стартовый индекс за концом массива Papyrus считает ошибкой.
            If i + 1 < rows.Length
                i = rows.FindStruct("ItemIndex", aItemIndex, i + 1)
            Else
                i = -1
            EndIf
        EndWhile
        chunk += 1
    EndWhile
    If AM_PatchPerks != None && AM_PatchPerks.Length > 0
        Int j = AM_PatchPerks.FindStruct("ItemIndex", aItemIndex, 0)
        While j >= 0
            out.Add(AM_PatchPerks[j], 1)
            If j + 1 < AM_PatchPerks.Length
                j = AM_PatchPerks.FindStruct("ItemIndex", aItemIndex, j + 1)
            Else
                j = -1
            EndIf
        EndWhile
    EndIf
    Return out
EndFunction

; Эффекты по броску GetRandomPercent — оценка риска для ветки радиации.
ChanceEffect[] Function GetChanceEffects(Int aItemIndex)
    ChanceEffect[] out = new ChanceEffect[0]
    Int chunk = 0
    While chunk < CHANCE_CHUNKS
        ChanceEffect[] rows = ChanceChunk(chunk)
        Int i = rows.FindStruct("ItemIndex", aItemIndex, 0)
        While i >= 0
            out.Add(rows[i], 1)
            ; Стартовый индекс за концом массива Papyrus считает ошибкой.
            If i + 1 < rows.Length
                i = rows.FindStruct("ItemIndex", aItemIndex, i + 1)
            Else
                i = -1
            EndIf
        EndWhile
        chunk += 1
    EndWhile
    Return out
EndFunction

